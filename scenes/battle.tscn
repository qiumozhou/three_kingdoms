[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/battle.gd" id="1_battle"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_command"]
bg_color = Color(0.15, 0.12, 0.25, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.65, 0.49, 0.28, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hover"]
bg_color = Color(0.37, 0.25, 0.15, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.88, 0.69, 0.39, 1)

[sub_resource type="Theme" id="Theme_commands"]
Button/colors/font_color = Color(0.96, 0.85, 0.62, 1)
Button/font_sizes/font_size = 14
Button/styles/normal = SubResource("StyleBoxFlat_command")
Button/styles/hover = SubResource("StyleBoxFlat_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_hover")

[node name="Battle" type="Node2D"]
texture_filter = 1
script = ExtResource("1_battle")

[node name="FriendlyName" type="Label" parent="."]
offset_left = 166.0
offset_top = 550.0
theme_override_font_sizes/font_size = 20
text = "关羽"

[node name="EnemyName" type="Label" parent="."]
offset_left = 560.0
offset_right = 794.0
offset_top = 550.0
theme_override_font_sizes/font_size = 20
text = "敌军主将"
horizontal_alignment = 2

[node name="BattleClock" type="Label" parent="."]
unique_name_in_owner = true
offset_left = 426.0
offset_top = 525.0
offset_right = 534.0
offset_bottom = 560.0
theme_override_colors/font_color = Color(0.19, 0.11, 0.08, 1)
theme_override_font_sizes/font_size = 22
text = "0 秒"
horizontal_alignment = 1
vertical_alignment = 1

[node name="CommandPanel" type="PanelContainer" parent="."]
offset_left = 164.0
offset_top = 675.0
offset_right = 796.0
offset_bottom = 709.0
theme = SubResource("Theme_commands")

[node name="Commands" type="HBoxContainer" parent="CommandPanel"]
theme_override_constants/separation = 12
alignment = 1

[node name="Advance" type="Button" parent="CommandPanel/Commands"]
custom_minimum_size = Vector2(118, 34)
text = "1  全军前进"

[node name="Hold" type="Button" parent="CommandPanel/Commands"]
custom_minimum_size = Vector2(118, 34)
text = "2  原地待命"

[node name="Retreat" type="Button" parent="CommandPanel/Commands"]
custom_minimum_size = Vector2(118, 34)
text = "3  全军后退"

[node name="SkillButton" type="Button" parent="CommandPanel/Commands"]
unique_name_in_owner = true
custom_minimum_size = Vector2(184, 34)
text = "4  青龙斩"

[node name="OrderLabel" type="Label" parent="."]
unique_name_in_owner = true
offset_left = 166.0
offset_top = 628.0
offset_right = 360.0
offset_bottom = 660.0
theme_override_font_sizes/font_size = 15
text = "军令 · 全军前进"
horizontal_alignment = 1

[node name="ResultLabel" type="Label" parent="."]
unique_name_in_owner = true
visible = false
offset_left = 330.0
offset_top = 260.0
offset_right = 630.0
offset_bottom = 370.0
theme_override_colors/font_color = Color(1, 0.87, 0.45, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.8)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_font_sizes/font_size = 36
text = "胜利"
horizontal_alignment = 1
vertical_alignment = 1

[connection signal="pressed" from="CommandPanel/Commands/Advance" to="." method="_on_advance_pressed"]
[connection signal="pressed" from="CommandPanel/Commands/Hold" to="." method="_on_hold_pressed"]
[connection signal="pressed" from="CommandPanel/Commands/Retreat" to="." method="_on_retreat_pressed"]
[connection signal="pressed" from="CommandPanel/Commands/SkillButton" to="." method="_cast_skill"]
